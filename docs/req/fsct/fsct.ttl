# CISA Framing Software Component Transparency, 3rd Edition (FSCT)
# Cybersecurity and Infrastructure Security Agency (CISA), 2024
# Source: https://www.cisa.gov/resources-tools/resources/framing-software-component-transparency-2024

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix fsct:  <https://w3id.org/bom/req/fsct/> .
@prefix bom:    <https://w3id.org/bom/> .

# FSCT sub-vocabulary; imports the SBOM bridge ontology
<https://w3id.org/bom/req/fsct/>
    a owl:Ontology ;
    owl:imports <https://w3id.org/bom/> ;
    owl:versionInfo "0.1.0" ;
    dcterms:creator <https://orcid.org/0000-0002-9698-1899> .


# ============================================================================
# CONCEPT SCHEME AND DEFINITIONS
# ============================================================================

fsct:scheme
    a skos:ConceptScheme, bom:InfoRequirementSpec ;
    skos:prefLabel "CISA FSCT (3rd Ed.) SBOM Minimum Elements"@en ;
    dcterms:title "CISA Framing Software Component Transparency (3rd ed., 2024)" ;
    dcterms:creator "Cybersecurity and Infrastructure Security Agency (CISA)" ;
    dcterms:issued "2024"^^xsd:gYear ;
    dcterms:source <https://www.cisa.gov/resources-tools/resources/framing-software-component-transparency-2024> ;
    skos:hasTopConcept
        fsct:author-name , fsct:timestamp , fsct:sbom-type ,
        fsct:primary-component , fsct:dependency-relationship ,
        fsct:name , fsct:version , fsct:supplier , fsct:unique-identifier ,
        fsct:cryptographic-hash , fsct:relationship ,
        fsct:concluded-license , fsct:copyright-notice .

fsct:author-name
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Author Name"@en ;
    skos:notation "BOM-FSCT-META-001"^^bom:SarifRuleId ;
    skos:exactMatch bom:doc-author .

fsct:timestamp
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Timestamp"@en ;
    skos:notation "BOM-FSCT-META-002"^^bom:SarifRuleId ;
    skos:exactMatch bom:doc-timestamp .

fsct:sbom-type
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "SBOM Type"@en ;
    skos:altLabel "SBOM generation context"@en ;
    skos:notation "BOM-FSCT-META-003"^^bom:SarifRuleId ;
    skos:exactMatch bom:doc-lifecycle-stage .

fsct:primary-component
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Primary Component"@en ;
    skos:notation "BOM-FSCT-META-004"^^bom:SarifRuleId ;
    skos:exactMatch bom:doc-primary-component .

fsct:dependency-relationship
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Dependency Relationship"@en ;
    skos:notation "BOM-FSCT-META-005"^^bom:SarifRuleId ;
    skos:exactMatch bom:MetadataRelationship .

fsct:name
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Component Name"@en ;
    skos:notation "BOM-FSCT-COMP-001"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-name .

fsct:version
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Version"@en ;
    skos:notation "BOM-FSCT-COMP-002"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-version .

fsct:supplier
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Supplier"@en ;
    skos:notation "BOM-FSCT-COMP-003"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-supplier .

fsct:unique-identifier
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Unique Identifier"@en ;
    skos:notation "BOM-FSCT-COMP-004"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-identifier .

fsct:cryptographic-hash
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Cryptographic Hash"@en ;
    skos:notation "BOM-FSCT-COMP-005"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-hash .

fsct:relationship
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Relationship"@en ;
    skos:notation "BOM-FSCT-COMP-006"^^bom:SarifRuleId ;
    skos:exactMatch bom:MetadataRelationship .

fsct:concluded-license
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Concluded License"@en ;
    skos:notation "BOM-FSCT-COMP-007"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-license .

fsct:copyright-notice
    a skos:Concept ;
    skos:topConceptOf fsct:scheme ;
    skos:inScheme fsct:scheme ;
    skos:prefLabel "Copyright Notice"@en ;
    skos:notation "BOM-FSCT-COMP-008"^^bom:SarifRuleId ;
    skos:exactMatch bom:component-copyright .


# ============================================================================
# OBLIGATION ASSERTIONS
# ============================================================================

fsct:author-name            bom:provisionType bom:Requirement .
fsct:timestamp              bom:provisionType bom:Requirement .
fsct:sbom-type              bom:provisionType bom:Requirement .
fsct:primary-component      bom:provisionType bom:Requirement .
fsct:dependency-relationship bom:provisionType bom:Requirement .
fsct:name                   bom:provisionType bom:Requirement .
fsct:version                bom:provisionType bom:Requirement .
fsct:supplier               bom:provisionType bom:Requirement .
fsct:unique-identifier      bom:provisionType bom:Requirement .
fsct:cryptographic-hash     bom:provisionType bom:Requirement .
fsct:relationship           bom:provisionType bom:Requirement .
fsct:concluded-license      bom:provisionType bom:Requirement .
fsct:copyright-notice       bom:provisionType bom:Requirement .
