# CISA SBOM Minimum Elements, 2025 edition
# Cybersecurity and Infrastructure Security Agency (CISA)

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix cisa:  <https://w3id.org/bom/req/cisa/> .
@prefix bom:    <https://w3id.org/bom/> .

# CISA sub-vocabulary; imports the SBOM bridge ontology
<https://w3id.org/bom/req/cisa/>
    a owl:Ontology ;
    owl:imports <https://w3id.org/bom/> ;
    owl:versionInfo "0.1.0" ;
    dcterms:creator <https://orcid.org/0000-0002-9698-1899> .


# ============================================================================
# CONCEPT SCHEME AND DEFINITIONS
# ============================================================================

cisa:scheme
    a skos:ConceptScheme, bom:InfoRequirementSpec ;
    skos:prefLabel "CISA SBOM Minimum Elements (2025)"@en ;
    dcterms:title "CISA SBOM Minimum Elements, 2025 edition" ;
    dcterms:creator "Cybersecurity and Infrastructure Security Agency (CISA)" ;
    dcterms:issued "2025"^^xsd:gYear ;
    skos:hasTopConcept
        cisa:author , cisa:timestamp , cisa:dependency-relationships ,
        cisa:name , cisa:version , cisa:identifier ,
        cisa:supplier , cisa:concluded-license , cisa:copyright-text .

cisa:author
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Document Author"@en ;
    skos:exactMatch bom:doc-author .

cisa:timestamp
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Document Timestamp"@en ;
    skos:exactMatch bom:doc-timestamp .

cisa:dependency-relationships
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Dependency Relationships"@en ;
    skos:exactMatch bom:MetadataRelationship .

cisa:name
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Component Name"@en ;
    skos:exactMatch bom:component-name .

cisa:version
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Component Version"@en ;
    skos:exactMatch bom:component-version .

cisa:identifier
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Component Identifier"@en ;
    skos:exactMatch bom:component-identifier .

cisa:supplier
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Component Supplier"@en ;
    skos:exactMatch bom:component-supplier .

cisa:concluded-license
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Concluded License"@en ;
    skos:exactMatch bom:component-license .

cisa:copyright-text
    a skos:Concept ;
    skos:topConceptOf cisa:scheme ;
    skos:inScheme cisa:scheme ;
    skos:prefLabel "Copyright Text"@en ;
    skos:exactMatch bom:component-copyright .


# ============================================================================
# OBLIGATION ASSERTIONS
# ============================================================================

cisa:doc-author            bom:provisionType bom:Requirement .
cisa:doc-timestamp         bom:provisionType bom:Requirement .
cisa:dependency-relationships bom:provisionType bom:Requirement .
cisa:name                  bom:provisionType bom:Requirement .
cisa:version               bom:provisionType bom:Requirement .
cisa:identifier            bom:provisionType bom:Requirement .
cisa:supplier              bom:provisionType bom:Requirement .
cisa:concluded-license     bom:provisionType bom:Requirement .
cisa:copyright-text        bom:provisionType bom:Requirement .
