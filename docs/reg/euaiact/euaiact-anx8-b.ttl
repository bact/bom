@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix cv:      <http://data.europa.eu/m8g/> .

@prefix bom:    <https://w3id.org/bom/> .
@prefix euaiact: <https://w3id.org/bom/reg/euaiact/> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .

# EU AI Act -- Annex VIII Section B
# Information to be submitted by providers of NOT-HIGH-RISK AI systems (Art. 49(2))
# 9 items.

<https://w3id.org/bom/reg/euaiact/anx8-b/>
    a owl:Ontology ;
    owl:imports <https://w3id.org/bom/> ;
    owl:imports <https://w3id.org/bom/reg/euaiact/art49/> ;
    dcterms:title "EU AI Act -- Annex VIII Section B: Provider, Not-High-Risk AI Systems (Art. 49(2))"@en ;
    dcterms:description """SKOS concept scheme for the 9 information items required
by EU AI Act Annex VIII Section B. Applies to providers who have determined their
Annex III system is NOT high-risk per Article 6(3) and register under Art. 49(2)."""@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    dcterms:creator <https://orcid.org/0000-0002-9698-1899> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:created "2026-06-17"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/annex/8/> ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/article/49/> ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> .

euaiact:scheme-anx8-b
    a skos:ConceptScheme, bom:RegulatorySpec ;
    skos:prefLabel "EU AI Act -- Annex VIII Section B (Art. 49(2))"@en ;
    dcterms:description """9 registration items for providers of not-high-risk AI systems
invoking Art.6(3). Source: Annex VIII Section B, Regulation (EU) 2024/1689."""@en ;
    skos:hasTopConcept euaiact:anx8-b .

euaiact:anx8-b
    a skos:Concept ;
    skos:topConceptOf euaiact:scheme-anx8-b ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:prefLabel "Annex VIII Section B -- Provider, not-high-risk AI systems (Art. 49(2))"@en ;
    skos:definition """Information to be submitted and kept up to date for AI systems
registered in accordance with Article 49(2) -- providers who have determined their
Annex III system is NOT high-risk per Article 6(3).
Source: Annex VIII Section B, Regulation (EU) 2024/1689."""@en ;
    skos:scopeNote """Section B is a lighter set than Section A: no certificate items (A.8/9),
no declaration of conformity (A.11), no instructions for use (A.12).
Instead B adds: Art.6(3) condition citation (B.6) and not-high-risk grounds summary (B.7)."""@en ;
    skos:narrower
        euaiact:anx8-b1-provider-info ,
        euaiact:anx8-b2-submitter ,
        euaiact:anx8-b3-authorised-rep ,
        euaiact:anx8-b4-system-identity ,
        euaiact:anx8-b5-intended-purpose ,
        euaiact:anx8-b6-art6-3-condition ,
        euaiact:anx8-b7-not-high-risk-grounds ,
        euaiact:anx8-b8-market-status ,
        euaiact:anx8-b9-member-states .

euaiact:anx8-b1-provider-info
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.1" ;
    skos:notation "BOM-EUAIACT-ANX8-B-001"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Provider name, address and contact details (B.1)"@en ;
    skos:definition "The name, address and contact details of the provider. (Annex VIII Sec.B item 1) -- same actor concept as A.1."@en ;
    skos:closeMatch bom:component-supplier ;
    skos:exactMatch euaiact:anx8-a1-provider-info ;
    dpv:hasDataSubject dpv:Organisation .

euaiact:anx8-b1-provider-info bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b2-submitter
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.2" ;
    skos:notation "BOM-EUAIACT-ANX8-B-002"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Submitter acting on behalf of provider (B.2)"@en ;
    skos:definition """Where submission is carried out by another person on behalf
of the provider, that person's name, address and contact details.
(Annex VIII Sec.B item 2) -- same concept as A.2."""@en ;
    skos:closeMatch bom:component-supplier ;
    skos:exactMatch euaiact:anx8-a2-submitter .

euaiact:anx8-b2-submitter bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b3-authorised-rep
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.3" ;
    skos:notation "BOM-EUAIACT-ANX8-B-003"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Authorised representative (where applicable) (B.3)"@en ;
    skos:definition "The name, address and contact details of the authorised representative, where applicable. (Annex VIII Sec.B item 3) -- same as A.3."@en ;
    skos:closeMatch bom:component-supplier ;
    skos:exactMatch euaiact:anx8-a3-authorised-rep .

euaiact:anx8-b3-authorised-rep bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b4-system-identity
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.4" ;
    skos:notation "BOM-EUAIACT-ANX8-B-004"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "AI system trade name and traceability reference (B.4)"@en ;
    skos:definition """The AI system trade name and any additional unambiguous
reference allowing identification and traceability.
(Annex VIII Sec.B item 4) -- same as A.4 but for not-high-risk systems."""@en ;
    skos:closeMatch bom:component-name ;
    skos:closeMatch bom:component-identifier .

euaiact:anx8-b4-system-identity bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b5-intended-purpose
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.5" ;
    skos:notation "BOM-EUAIACT-ANX8-B-005"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Intended purpose (B.5)"@en ;
    skos:definition """A description of the intended purpose of the AI system.
(Annex VIII Sec.B item 5)
Note: Section B does NOT require the components/functions or data/logic description
that Section A requires (items A.5-A.6). Scope is narrower."""@en ;
    skos:closeMatch bom:component-description ;
    skos:closeMatch bom:ai-application-domain .

euaiact:anx8-b5-intended-purpose bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b6-art6-3-condition
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.6" ;
    skos:notation "BOM-EUAIACT-ANX8-B-006"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Art.6(3) condition for not-high-risk determination (B.6)"@en ;
    skos:definition """The condition or conditions under Article 6(3) based on
which the AI system is considered to be not-high-risk.
(Annex VIII Sec.B item 6)
This is the key Section-B-specific element linking to the legal basis
for the not-high-risk self-assessment."""@en ;
    skos:relatedMatch dpv:Justification .

euaiact:anx8-b6-art6-3-condition bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b7-not-high-risk-grounds
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.7" ;
    skos:notation "BOM-EUAIACT-ANX8-B-007"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Summary of grounds for not-high-risk determination (B.7)"@en ;
    skos:definition """A short summary of the grounds on which the AI system is
considered to be not-high-risk in application of the procedure under Article 6(3).
(Annex VIII Sec.B item 7)"""@en ;
    skos:relatedMatch dpv:Justification .

euaiact:anx8-b7-not-high-risk-grounds bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b8-market-status
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.8" ;
    skos:notation "BOM-EUAIACT-ANX8-B-008"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Market availability status (B.8)"@en ;
    skos:definition """The status of the AI system: on the market or in service;
no longer placed on the market / in service; recalled.
(Annex VIII Sec.B item 8) -- same concept as A.7."""@en ;
    skos:exactMatch euaiact:anx8-a7-market-status .

euaiact:anx8-b8-market-status bom:provisionType bom:ExternalConstraint .

euaiact:anx8-b9-member-states
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-b ;
    skos:broader euaiact:anx8-b ;
    skos:notation "B.9" ;
    skos:notation "BOM-EUAIACT-ANX8-B-009"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Member states of market availability (B.9)"@en ;
    skos:definition """Any Member States in which the AI system has been placed on
the market, put into service or made available in the Union.
(Annex VIII Sec.B item 9) -- same concept as A.10."""@en ;
    skos:exactMatch euaiact:anx8-a10-member-states .

euaiact:anx8-b9-member-states bom:provisionType bom:ExternalConstraint .

euaiact:non-public-anx8-b
    a skos:Collection ;
    skos:prefLabel "Non-public registration: Section B subset (pts 1-5, 8, 9)"@en ;
    skos:scopeNote """Items required in the non-public EU database section for
not-high-risk law enforcement/migration/asylum/border systems invoking Art.6(3).
Excludes: B.6 and B.7."""@en ;
    skos:member euaiact:anx8-b1-provider-info ;
    skos:member euaiact:anx8-b2-submitter ;
    skos:member euaiact:anx8-b3-authorised-rep ;
    skos:member euaiact:anx8-b4-system-identity ;
    skos:member euaiact:anx8-b5-intended-purpose ;
    skos:member euaiact:anx8-b8-market-status ;
    skos:member euaiact:anx8-b9-member-states .
