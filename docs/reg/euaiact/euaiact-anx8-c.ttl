@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix cv:      <http://data.europa.eu/m8g/> .

@prefix bom:    <https://w3id.org/bom/> .
@prefix euaiact: <https://w3id.org/bom/reg/euaiact/> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .

# EU AI Act -- Annex VIII Section C
# Information to be submitted by DEPLOYERS of high-risk AI systems (Art. 49(3))
# 5 items. Required when deployer is a public authority or EU institution/agency/body.

<https://w3id.org/bom/reg/euaiact/anx8-c/>
    a owl:Ontology ;
    owl:imports <https://w3id.org/bom/> ;
    owl:imports <https://w3id.org/bom/reg/euaiact/art49/> ;
    dcterms:title "EU AI Act -- Annex VIII Section C: Deployer Registration (Art. 49(3))"@en ;
    dcterms:description """SKOS concept scheme for the 5 information items required
by EU AI Act Annex VIII Section C. Applies to deployers of high-risk AI systems
that are public authorities or EU institutions/agencies/bodies (Art. 49(3)).
Filed in addition to the provider's Section A registration."""@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    dcterms:creator <https://orcid.org/0000-0002-9698-1899> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:created "2026-06-17"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/annex/8/> ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/article/49/> ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> .

euaiact:scheme-anx8-c
    a skos:ConceptScheme, bom:RegulatorySpec ;
    skos:prefLabel "EU AI Act -- Annex VIII Section C (Art. 49(3))"@en ;
    dcterms:description """5 registration items for deployers (public authorities /
EU institutions) of high-risk AI systems. Source: Annex VIII Section C,
Regulation (EU) 2024/1689."""@en ;
    skos:hasTopConcept euaiact:anx8-c .

euaiact:anx8-c
    a skos:Concept ;
    skos:topConceptOf euaiact:scheme-anx8-c ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:prefLabel "Annex VIII Section C -- Deployer registration (Art. 49(3))"@en ;
    skos:definition """Information to be submitted and kept up to date by deployers
of high-risk AI systems in accordance with Article 49(3).
Required when the deployer is a public authority or EU institution, agency or body.
Source: Annex VIII Section C, Regulation (EU) 2024/1689."""@en ;
    skos:scopeNote """Section C is filed alongside the provider's Section A registration,
not as an alternative. It covers deployer-specific data: deployer identity,
FRIA summary, and DPIA summary -- information the provider typically cannot supply."""@en ;
    skos:narrower
        euaiact:anx8-c1-deployer-info ,
        euaiact:anx8-c2-deployer-submitter ,
        euaiact:anx8-c3-provider-db-url ,
        euaiact:anx8-c4-fria-summary ,
        euaiact:anx8-c5-dpia-summary .

euaiact:anx8-c1-deployer-info
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:broader euaiact:anx8-c ;
    skos:notation "C.1" ;
    skos:notation "BOM-EUAIACT-ANX8-C-001"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Deployer name, address and contact details (C.1)"@en ;
    skos:definition "The name, address and contact details of the deployer. (Annex VIII Sec.C item 1)"@en ;
    skos:closeMatch bom:component-supplier ;
    dpv:hasDataSubject dpv:PublicAuthority .

euaiact:anx8-c1-deployer-info bom:provisionType bom:ExternalConstraint .

euaiact:anx8-c2-deployer-submitter
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:broader euaiact:anx8-c ;
    skos:notation "C.2" ;
    skos:notation "BOM-EUAIACT-ANX8-C-002"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Submitter acting on behalf of deployer (C.2)"@en ;
    skos:definition """The name, address and contact details of the person
submitting information on behalf of the deployer.
(Annex VIII Sec.C item 2)"""@en ;
    skos:closeMatch bom:component-supplier .

euaiact:anx8-c2-deployer-submitter bom:provisionType bom:ExternalConstraint .

euaiact:anx8-c3-provider-db-url
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:broader euaiact:anx8-c ;
    skos:notation "C.3" ;
    skos:notation "BOM-EUAIACT-ANX8-C-003"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "URL of provider's EU database entry (C.3)"@en ;
    skos:definition """The URL of the entry of the AI system in the EU database
as registered by its provider. (Annex VIII Sec.C item 3)
Links the deployer's Section C record to the provider's Section A record."""@en ;
    skos:closeMatch bom:component-identifier .

euaiact:anx8-c3-provider-db-url bom:provisionType bom:ExternalConstraint .

euaiact:anx8-c4-fria-summary
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:broader euaiact:anx8-c ;
    skos:notation "C.4" ;
    skos:notation "BOM-EUAIACT-ANX8-C-004"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Fundamental rights impact assessment summary (C.4)"@en ;
    skos:definition """A summary of the findings of the fundamental rights impact
assessment (FRIA) conducted in accordance with Article 27.
(Annex VIII Sec.C item 4)"""@en ;
    skos:closeMatch bom:security-compliance .

euaiact:anx8-c4-fria-summary bom:provisionType bom:ExternalConstraint .

euaiact:anx8-c5-dpia-summary
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-c ;
    skos:broader euaiact:anx8-c ;
    skos:notation "C.5" ;
    skos:notation "BOM-EUAIACT-ANX8-C-005"^^bom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Data protection impact assessment summary [where applicable] (C.5)"@en ;
    skos:definition """A summary of the data protection impact assessment (DPIA)
carried out in accordance with Article 35 of Regulation (EU) 2016/679 or
Article 27 of Directive (EU) 2016/680, where applicable.
(Annex VIII Sec.C item 5)"""@en ;
    skos:closeMatch bom:security-compliance ;
    dpv:hasLegalBasis dpv:LegitimateInterest .

euaiact:anx8-c5-dpia-summary bom:provisionType bom:ConditionalRequirement .

euaiact:non-public-anx8-c
    a skos:Collection ;
    skos:prefLabel "Non-public registration: Section C subset (pts 1-3)"@en ;
    skos:scopeNote """Items required in the non-public EU database section under Art.49(4)
when deployer is a public authority (Q5=Yes) and system is in law enforcement domain.
Excludes: C.4 (FRIA summary) and C.5 (DPIA summary)."""@en ;
    skos:member euaiact:anx8-c1-deployer-info ;
    skos:member euaiact:anx8-c2-deployer-submitter ;
    skos:member euaiact:anx8-c3-provider-db-url .
