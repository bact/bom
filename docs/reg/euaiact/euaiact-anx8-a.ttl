@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix cv:      <http://data.europa.eu/m8g/> .

@prefix sbom:    <https://w3id.org/sbom/> .
@prefix euaiact: <https://w3id.org/sbom/reg/euaiact/> .
@prefix eli:     <http://data.europa.eu/eli/ontology#> .

# EU AI Act -- Annex VIII Section A
# Information to be submitted by providers of HIGH-RISK AI systems (Art. 49(1))
# 13 items.

<https://w3id.org/sbom/reg/euaiact/anx8-a/>
    a owl:Ontology ;
    owl:imports <https://w3id.org/sbom/> ;
    owl:imports <https://w3id.org/sbom/reg/euaiact/art49/> ;
    dcterms:title "EU AI Act -- Annex VIII Section A: Provider, High-Risk AI Systems (Art. 49(1))"@en ;
    dcterms:description """SKOS concept scheme for the 13 information items required
by EU AI Act Annex VIII Section A. Applies to providers of high-risk AI systems
registering in the EU database under Article 49(1)."""@en ;
    dcterms:source <https://eur-lex.europa.eu/eli/reg/2024/1689/oj/eng> ;
    dcterms:creator <https://orcid.org/0000-0002-9698-1899> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:created "2026-06-17"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/annex/8/> ;
    rdfs:seeAlso <https://artificialintelligenceact.eu/article/49/> ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> .

euaiact:scheme-anx8-a
    a skos:ConceptScheme, sbom:RegulatorySpec ;
    skos:prefLabel "EU AI Act -- Annex VIII Section A (Art. 49(1))"@en ;
    dcterms:description """13 registration items for providers of high-risk AI systems
(Art.49(1)). Source: Annex VIII Section A, Regulation (EU) 2024/1689."""@en ;
    skos:hasTopConcept euaiact:anx8-a .

euaiact:anx8-a
    a skos:Concept ;
    skos:topConceptOf euaiact:scheme-anx8-a ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:prefLabel "Annex VIII Section A -- Provider, high-risk AI systems (Art. 49(1))"@en ;
    skos:definition """Information to be submitted and kept up to date by providers
of high-risk AI systems registered in accordance with Article 49(1).
Source: Annex VIII Section A, Regulation (EU) 2024/1689."""@en ;
    skos:narrower
        euaiact:anx8-a1-provider-info ,
        euaiact:anx8-a2-submitter ,
        euaiact:anx8-a3-authorised-rep ,
        euaiact:anx8-a4-system-identity ,
        euaiact:anx8-a5-purpose-and-functions ,
        euaiact:anx8-a6-data-and-logic ,
        euaiact:anx8-a7-market-status ,
        euaiact:anx8-a8-certificate ,
        euaiact:anx8-a9-certificate-copy ,
        euaiact:anx8-a10-member-states ,
        euaiact:anx8-a11-declaration-of-conformity ,
        euaiact:anx8-a12-instructions-for-use ,
        euaiact:anx8-a13-additional-url .

euaiact:anx8-a1-provider-info
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.1" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-001"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Provider name, address and contact details (A.1)"@en ;
    skos:definition "The name, address and contact details of the provider. (Annex VIII Sec.A item 1)"@en ;
    skos:closeMatch sbom:component-supplier ;
    dpv:hasDataSubject dpv:Organisation .

euaiact:anx8-a1-provider-info sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a2-submitter
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.2" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-002"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Submitter acting on behalf of provider (A.2)"@en ;
    skos:definition """Where submission is carried out by another person on behalf
of the provider, that person's name, address and contact details.
(Annex VIII Sec.A item 2)"""@en ;
    skos:closeMatch sbom:component-supplier .

euaiact:anx8-a2-submitter sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a3-authorised-rep
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.3" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-003"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Authorised representative (where applicable) (A.3)"@en ;
    skos:definition """The name, address and contact details of the authorised
representative, where applicable (Art. 22). (Annex VIII Sec.A item 3)"""@en ;
    skos:closeMatch sbom:component-supplier .

euaiact:anx8-a3-authorised-rep sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a4-system-identity
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.4" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-004"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "AI system trade name and traceability reference (A.4)"@en ;
    skos:definition """The AI system trade name and any additional unambiguous
reference allowing the identification and traceability of the AI system.
(Annex VIII Sec.A item 4)"""@en ;
    skos:exactMatch sbom:component-name ;
    skos:closeMatch sbom:component-identifier .

euaiact:anx8-a4-system-identity sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a5-purpose-and-functions
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.5" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-005"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Intended purpose and components/functions (A.5)"@en ;
    skos:definition """A description of the intended purpose of the AI system and
of the components and functions supported through this AI system.
(Annex VIII Sec.A item 5)"""@en ;
    skos:closeMatch sbom:component-description ;
    skos:closeMatch sbom:ai-application-domain .

euaiact:anx8-a5-purpose-and-functions sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a6-data-and-logic
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.6" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-006"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Data, inputs and operating logic description (A.6)"@en ;
    skos:definition """A basic and concise description of the information used by
the system (data, inputs) and its operating logic.
(Annex VIII Sec.A item 6)"""@en ;
    skos:scopeNote "No direct equivalent in current SBOM exchange formats. Closest bridge: sbom:ai-data-usage or sbom:dataset-type."@en ;
    skos:closeMatch sbom:ai-data-usage ;
    skos:closeMatch sbom:dataset-type .

euaiact:anx8-a6-data-and-logic sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a7-market-status
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.7" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-007"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Market availability status (A.7)"@en ;
    skos:definition """The status of the AI system: on the market or in service;
no longer placed on the market / in service; recalled.
(Annex VIII Sec.A item 7)"""@en ;
    skos:scopeNote "No exact SBOM equivalent. spdx-ai:supportLevel approximates but does not precisely match EU market status categories."@en .

euaiact:anx8-a7-market-status sbom:provisionType sbom:ExternalConstraint .
euaiact:anx8-a7-market-status sbom:valueConstraint euaiact:market-status-values .

euaiact:market-status-values
    a skos:Collection ;
    skos:prefLabel "Market status allowed values (Annex VIII Sec.A item 7 / B item 8)"@en ;
    skos:member euaiact:status-available ;
    skos:member euaiact:status-withdrawn ;
    skos:member euaiact:status-recalled .

euaiact:status-available
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a7-market-status ;
    skos:prefLabel "On the market or in service"@en .

euaiact:status-withdrawn
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a7-market-status ;
    skos:prefLabel "No longer placed on the market or in service"@en .

euaiact:status-recalled
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a7-market-status ;
    skos:prefLabel "Recalled"@en .

euaiact:anx8-a8-certificate
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.8" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-008"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Notified body certificate (type, number, expiry) [where applicable] (A.8)"@en ;
    skos:definition """The type, number and expiry date of the certificate issued
by the notified body and the name or identification number of that notified body,
where applicable. Required only for systems that underwent third-party conformity assessment.
(Annex VIII Sec.A item 8)"""@en ;
    skos:scopeNote "No SBOM equivalent. Regulatory compliance metadata."@en .

euaiact:anx8-a8-certificate sbom:provisionType sbom:ConditionalRequirement .

euaiact:anx8-a9-certificate-copy
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.9" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-009"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Scanned copy of notified body certificate [where applicable] (A.9)"@en ;
    skos:definition "A scanned copy of the certificate referred to in item 8, where applicable. (Annex VIII Sec.A item 9)"@en ;
    skos:scopeNote "Binary document attachment; no SBOM equivalent."@en .

euaiact:anx8-a9-certificate-copy sbom:provisionType sbom:ConditionalRequirement .

euaiact:anx8-a10-member-states
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.10" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-010"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Member states of market availability (A.10)"@en ;
    skos:definition """Any Member States in which the AI system has been placed on
the market, put into service or made available in the Union.
(Annex VIII Sec.A item 10)"""@en ;
    skos:scopeNote "Geographic deployment scope. No equivalent in SBOM formats. Could be modelled as dpv:hasJurisdiction on the AI system record."@en .

euaiact:anx8-a10-member-states sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a11-declaration-of-conformity
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.11" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-011"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "EU declaration of conformity (copy) (A.11)"@en ;
    skos:definition "A copy of the EU declaration of conformity referred to in Article 47. (Annex VIII Sec.A item 11)"@en ;
    skos:closeMatch sbom:security-compliance .

euaiact:anx8-a11-declaration-of-conformity sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a12-instructions-for-use
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.12" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-012"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "Electronic instructions for use [exception: law enforcement/migration/asylum/border] (A.12)"@en ;
    skos:definition """Electronic instructions for use as required by Article 13.
(Annex VIII Sec.A item 12)

EXCEPTION: NOT required for high-risk AI systems in Annex III points 1, 6 and 7
(law enforcement; migration, asylum and border control management).
These systems register in the NON-PUBLIC section."""@en ;
    skos:closeMatch sbom:component-external-reference .

euaiact:anx8-a12-instructions-for-use sbom:provisionType sbom:ExternalConstraint .

euaiact:anx8-a13-additional-url
    a skos:Concept ;
    skos:inScheme euaiact:scheme-anx8-a ;
    skos:broader euaiact:anx8-a ;
    skos:notation "A.13" ;
    skos:notation "SBOM-EUAIACT-ANX8-A-013"^^sbom:SarifRuleId ;
    rdfs:seeAlso <http://data.europa.eu/eli/reg/2024/1689/anx_8/oj> ;
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=OJ:L_202401689#anx_VIII> ;
    skos:prefLabel "URL for additional information (optional) (A.13)"@en ;
    skos:definition "A URL for additional information (optional). (Annex VIII Sec.A item 13)"@en ;
    skos:closeMatch sbom:component-external-reference .

euaiact:anx8-a13-additional-url sbom:provisionType sbom:Permission .

# Non-public Section A subset (Art.49(4) law enforcement/migration/asylum/border path)
euaiact:non-public-anx8-a
    a skos:Collection ;
    skos:prefLabel "Non-public registration: Section A subset (pts 1-5, 7, 10)"@en ;
    skos:scopeNote """Items required in the non-public EU database section under Art.49(4)
for high-risk law enforcement/migration/asylum/border providers.
Excludes: items 6, 8, 9, 11, 12, 13."""@en ;
    skos:member euaiact:anx8-a1-provider-info ;
    skos:member euaiact:anx8-a2-submitter ;
    skos:member euaiact:anx8-a3-authorised-rep ;
    skos:member euaiact:anx8-a4-system-identity ;
    skos:member euaiact:anx8-a5-purpose-and-functions ;
    skos:member euaiact:anx8-a7-market-status ;
    skos:member euaiact:anx8-a10-member-states .
